# ==============================================================================
# Multi-Market LMS Platform - Environment Configuration Template
# ==============================================================================
# NOTE: DO NOT commit actual secrets or credentials to source control.
# Copy this file to .env.local for local development.

# Application Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Database Connection (MongoDB URI)
MONGODB_URI=mongodb://localhost:27017/lms

# Session & Token Encryption Secret (min 32 characters)
SESSION_SECRET=dev_session_secret_replace_in_production_min_32_chars

# Provider Configuration
# Set to 'true' to use in-memory / local mock payment simulation
USE_MOCK_PAYMENT=true

# Set to 'true' to use local meeting simulation without Zoom credentials
USE_MOCK_MEETING=true

# Market-Specific Payment Credential Placeholders (Resolved by reference)
# In production, these are provisioned in secure secret management
HITPAY_SG_API_KEY=
HITPAY_SG_SALT=

HITPAY_MY_API_KEY=
HITPAY_MY_SALT=
