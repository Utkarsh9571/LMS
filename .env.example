# ==============================================================================
# Multi-Market LMS Platform - Environment Configuration Template
# ==============================================================================
# NOTE: DO NOT commit actual secrets or credentials to source control.
# Copy this file to .env.local for local development.

# Application Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Database Connection (MongoDB URI)
MONGODB_URI=mongodb://localhost:27017/lms

# Session & Token Encryption Secret (min 32 characters)
SESSION_SECRET=dev_session_secret_replace_in_production_min_32_chars

# Provider Mock Toggles (Set to 'false' in production to use real providers)
USE_MOCK_PAYMENT=true
USE_MOCK_MEETING=true
USE_MOCK_STORAGE=true
USE_MOCK_NOTIFICATION=true

# Market-Specific Payment Credentials (HitPay SG & MY)
HITPAY_SG_API_KEY=
HITPAY_SG_SALT=

HITPAY_MY_API_KEY=
HITPAY_MY_SALT=

# S3-Compatible Object Storage Provider (AWS S3, Cloudflare R2, MinIO)
STORAGE_PROVIDER=mock
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_FORCE_PATH_STYLE=false

# Live Meeting Provider (Zoom Server-to-Server OAuth)
MEETING_PROVIDER=mock
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Transactional Email Notification Provider (Resend HTTPS REST API)
NOTIFICATION_PROVIDER=mock
EMAIL_FROM=noreply@bimacademy.com
EMAIL_API_KEY=
EMAIL_API_ENDPOINT=https://api.resend.com/emails
